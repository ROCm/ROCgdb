msgstr ""
"  --auto-relink               reexecută editorul de legături folosind scriptul\n"
"                              de suprapunere automată\n"

#: eelf32_spu.c:1098
#, c-format
msgid ""
"  --overlay-rodata            Place read-only data with associated function\n"
"                                code in overlays\n"
msgstr ""
