0000:[ 	]+00020004[ 	]+00020004[ 	]+_GLOBAL_OFFSET_TABLE_ \+ 0x4
0001:[ 	]+0000000f[ 	]+00020008[ 	]+_GLOBAL_OFFSET_TABLE_ \+ 0x8
[ 	]+0002000c[ 	]+_GLOBAL_OFFSET_TABLE_ \+ 0xc
[ 	]+00020010[ 	]+_GLOBAL_OFFSET_TABLE_ \+ 0x10
