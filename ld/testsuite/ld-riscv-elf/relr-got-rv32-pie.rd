Relocation section '\.rela\.dyn'.*contains 2 entries:
[ 	]+Offset[ 	]+Info[ 	]+Type[ 	]+.*
00000000[ 	]+[0-9a-f]+[ 	]+R_RISCV_NONE[ 	]+0
00020018[ 	]+[0-9a-f]+[ 	]+R_RISCV_32[ 	]+00000000[ 	]+sym_weak_undef \+ 0

