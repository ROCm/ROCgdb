# A linker script can retarget the output BFD away from x86 with
# OUTPUT_FORMAT.  The x86 emulation still calls
# bfd_elf_linker_x86_set_options.  That function must not mistake the
# foreign link hash table for a struct elf_x86_link_hash_table.

# The linker scripts below are written to the local tmpdir, which a
# remote host cannot see.
if { [is_remote host] } {
    return
}

set test "x86-64 output target confusion"

# A different target has neither this test's assembler nor its emulation,
# so skip silently there, as the rest of ld-x86-64 does.  Once the target
# matches, both remaining preconditions record a result, so a missing
# emulation or a failed assembly cannot go unreported.
if { !([istarget "x86_64-*-elf*"] || [istarget "x86_64-*-linux*"]) } {
    return
}

if { ![ld_supports_emul "elf_x86_64"] } {
    unsupported "$test (elf_x86_64 emulation not supported)"
    return
}

# Write a minimal linker script that selects an output format.  ARCH may
# be empty, in which case the format's own default is used.
proc arch_confusion_script { path format arch } {
    set fp [open $path w]
    puts $fp "OUTPUT_FORMAT(\"$format\")"
    if { $arch ne "" } {
	puts $fp "OUTPUT_ARCH($arch)"
    }
    puts $fp "SECTIONS"
    puts $fp "{"
    puts $fp "  .text : { *(.text) }"
    puts $fp "}"
    close $fp
}

# Link OBJ with -melf_x86_64 and the linker script at SCRIPT, and return
# the linker diagnostics.  binutils' run_host_cmd returns the output
# text only, so the exit status is not available here.
proc arch_confusion_link { script obj out } {
    global ld
    catch { file delete -force $out }
    return [run_host_cmd "$ld" "-melf_x86_64 -T $script -o $out $obj"]
}

# Foreign ELF output formats to try, as {format architecture}.  Both
# names have to be valid for the BFD backend, or ld rejects the script
# before the x86 emulation hook runs and nothing is tested.  A name this
# build does not know is recognised from the diagnostic and the next
# candidate is tried.  Each format has an ELF link hash table, and the
# unpatched tree overflows under AddressSanitizer for each of them.
set arch_confusion_elf_targets {
    {elf64-bpfle          bpf}
    {elf32-littlearc      arc}
    {elf64-littleriscv    riscv}
    {elf32-xtensa-le      xtensa}
    {elf32-microblaze     microblaze}
    {elf64-tilegx-le      tilegx}
    {elf32-or1k           or1k}
    {elf32-bfin           bfin}
}

if { ![ld_assemble $as "--64 $srcdir/$subdir/arch-confusion.s" \
	 tmpdir/arch-confusion.o] } {
    unsupported "$test (could not assemble the input)"
    return
}

# A non-ELF output format has no ELF backend data.  The x86 hook must
# decline to touch it.  Such a link is unaffected and must succeed.
#
# This block does not reproduce the original overflow.  What it pins is
# the ORDER of the tests in elf_x86_hash_table.  is_elf_hash_table must
# stay first: it short circuits for a non-ELF output, so bed->target_id
# is never read and the link has no ELF backend data to read from.  Move
# the id test in front of it and this link segfaults.
arch_confusion_script tmpdir/arch-confusion-binary.t "binary" ""
if { [ld_link $ld tmpdir/arch-confusion-binary.out \
	 "-melf_x86_64 -T tmpdir/arch-confusion-binary.t \
	  tmpdir/arch-confusion.o"] } {
    pass "$test (non-ELF output format)"
} else {
    fail "$test (link to the binary output format should have succeeded)"
}

# A foreign ELF output format still gets an ELF link hash table, just
# not an x86 one.  The link is expected to fail, but only because the
# input object does not match the foreign architecture.  That diagnostic
# is printed after the output file has been opened and the x86 hook has
# run, so requiring it proves the hook returned cleanly.  Any other
# result, in particular a sanitizer report from the out of bounds store,
# is a failure.  A candidate this build lacks is logged and skipped.  The
# test is unsupported only when no candidate is available.
set found 0
foreach target $arch_confusion_elf_targets {
    set format [lindex $target 0]
    set arch [lindex $target 1]

    arch_confusion_script tmpdir/arch-confusion-elf.t $format $arch
    set output [arch_confusion_link tmpdir/arch-confusion-elf.t \
		    tmpdir/arch-confusion.o tmpdir/arch-confusion-elf.out]

    if { [regexp "target $format not found" $output]
	 || [regexp "cannot represent machine" $output] } {
	verbose -log "no $format target in this build, skipping it"
	continue
    }

    set found 1

    if { [regexp "architecture of input file .* is incompatible with" \
		 $output] } {
	pass "$test (foreign ELF output format $format)"
    } else {
	fail "$test (foreign ELF output format $format: $output)"
    }
    break
}

if { !$found } {
    unsupported "$test (foreign ELF output format)"
}

catch { file delete -force tmpdir/arch-confusion-binary.t }
catch { file delete -force tmpdir/arch-confusion-binary.out }
catch { file delete -force tmpdir/arch-confusion-elf.t }
catch { file delete -force tmpdir/arch-confusion-elf.out }
catch { file delete -force tmpdir/arch-confusion.o }
