# Test handling of vRun packet where argument fields contains invalid
# non-hex characters.

load_lib gdbserver-support.exp

require allow_gdbserver_tests

standard_testfile normal.c

save_vars { GDBFLAGS } {
    # If GDB and GDBserver are both running locally, set the sysroot to avoid
    # reading files via the remote protocol.
    if { ![is_remote host] && ![is_remote target] } {
	set GDBFLAGS "$GDBFLAGS -ex \"set sysroot\""
    }
    if {[prepare_for_testing "failed to prepare" $testfile $srcfile]} {
	return
    }
}

# Make sure we're disconnected, in case we're testing with an
# extended-remote board, therefore already connected.
gdb_test "disconnect" ".*"

# Start gdbserver and connect.  Must start in extended mode so that we
# can use vRun.
set target_exec [gdbserver_download_current_prog]

set res [gdbserver_start "--multi" $target_exec]
set gdbserver_protocol "extended-remote"
set gdbserver_gdbport [lindex $res 1]
gdb_target_cmd $gdbserver_protocol $gdbserver_gdbport

# Send a valid vRun packet to prove that gdbserver isn't rejecting all
# packets.
gdb_test "maint packet vRun;;6162" "\r\nreceived: \"T.*" \
    "valid vRun packet accepted"

# Send an invalid packet.  Once upon a time this used to leak memory
# inside gdbserver.
gdb_test "maint packet vRun;;xxxx" "\r\nreceived: \"E01\"" \
    "non-hex inferior argument rejected"
