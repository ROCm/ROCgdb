# Check that local variables do not occur in the cooked index.

standard_testfile .f90

# Only the debug info of the test file matters here, so compile it to an
# object file and load that, instead of linking an executable.  Linking adds
# the Fortran runtime, which can come with a lot of debug info.  Then "maint
# print objfiles" prints an index entry for every symbol of the runtime too,
# tens of megabytes, which takes very long to read when each read returns a
# single byte (check-read1).
set objfile [standard_output_file ${testfile}.o]
if { [gdb_compile "${srcdir}/${subdir}/${srcfile}" ${objfile} object \
	  {debug f90}] != "" } {
    untested "failed to compile"
    return
}

clean_restart ${testfile}.o

# Regression test for PR32276.
gdb_test_lines "maint print objfiles" "local var not in index" "" -re-not "local_var"

# Check that we still can find the type of the local variable, even when not
# in the function.
set hs \[^\r\n\]+
gdb_test "ptype test::local_var" " = $hs"
