# Test reporting out of range LDS access on supported architecture.
# SIGBUS is expected when lds-exception is on, and an assertion
# failure is expected when it is off.

load_lib rocm.exp

require allow_hip_tests

standard_testfile .cpp

if {[prepare_for_testing "failed to prepare ${testfile}" \
			 $testfile $srcfile {debug hip}]} {
    return
}


with_rocm_gpu_lock {

if {![runto_main]} {
    return
}
# Run with lds-exception off (the default), we should see an
# assertion failure.
gdb_breakpoint "kern" -allow-pending -qualified
gdb_continue_to_breakpoint "with exception off"
gdb_test "show amdgpu lds-exception" \
    "exception reporting is off \\(currently disabled\\)\\." \
    "exception reporting for LDS access must be disabled"

delete_breakpoints

gdb_test "continue" \
    ": Device-side assertion `arr\\\[idx\\\] == 77' failed\\..*" \
    "continue to assertion failure"
}

clean_restart ${::testfile}

with_rocm_gpu_lock {
if {![runto_main]} {
    return
 }

# Check if lds-exception can be enabled.
# The first regex is for cases where the feature could not be enabled.
# The second regex is for dbgapi versions that don't support property
# setting and hence, setting the LDS exception at the interface level.
# This one must go away when we bump the dbgapi version requirement.
set warning 0
gdb_test_multiple "set amdgpu lds-exception on" "" {
    -re -wrap "warning: .* could not be enabled\\." {
	set warning 1
	pass $gdb_test_name
    }
    -re -wrap "warning: dbgapi does not support lds exception setting" {
	set warning 1
	pass $gdb_test_name
    }
    -re -wrap "" {
	pass $gdb_test_name
    }
}
if {$warning} {
    unsupported "no exception reporting to enable"
    return
}

gdb_test "show amdgpu lds-exception" \
    "exception reporting is on \\(currently enabled\\)\\." \
    "exception reporting for LDS access must be enabled"

gdb_test "continue" \
    "Thread ${::decimal}\[^\r\n\]* received signal SIGBUS, Bus error.*" \
    "continue to sigbus error"
}
