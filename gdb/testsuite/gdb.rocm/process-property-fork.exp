# Test that the
#
#   set amdgpu precise-memory
#   set amdgpu precise-alu-exceptions
#   set lds-exception
#
# settings are inherited by a forked child.

load_lib rocm.exp

require allow_hip_tests
require allow_fork_tests

standard_testfile .c

if {[prepare_for_testing "failed to prepare $testfile" $testfile $srcfile {debug}]} {
    return
}

with_rocm_gpu_lock {
    if {![runto_main]} {
	return
    }

    # Check that the properties are off (default).
    foreach property {precise-memory precise-alu-exceptions \
		      lds-exception} {
	gdb_test "show amdgpu $property" " is off.*" \
	    "show amdgpu $property before set"
    }

    # Set the properties on in the parent, before fork.
    foreach property {precise-memory precise-alu-exceptions \
		      lds-exception} {
	gdb_test "set amdgpu $property on"
	gdb_test "show amdgpu $property" " is on.*" \
	    "show amdgpu $property after set"
    }

    # Continue past fork, following the child.
    # The setting should still be on.
    gdb_test_no_output "set follow-fork-mode child"
    gdb_test "break child"
    gdb_test "continue" "Thread 2.1 .* hit Breakpoint .*"
    foreach property {precise-memory precise-alu-exceptions \
		      lds-exception} {
	gdb_test "show amdgpu $property" " is on.*" \
	    "show amdgpu $property after fork"
    }
}
