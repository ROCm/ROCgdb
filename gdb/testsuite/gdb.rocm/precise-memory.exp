# Test showing the "amdgpu precise-memory" setting.

load_lib rocm.exp

require allow_hip_tests

standard_testfile .cpp

if {[build_executable "failed to prepare" $testfile $srcfile {debug hip}]} {
    return
}

proc do_test { } {
    clean_restart
    gdb_load $::binfile

    with_rocm_gpu_lock {
	if {![runto_main]} {
	    return
	}

	gdb_test "show amdgpu precise-memory" \
	    "AMDGPU precise memory access reporting is off \\(currently disabled\\)." \
	    "show precise-memory setting in CLI before"
	gdb_test "interpreter-exec mi \"-gdb-show amdgpu precise-memory\"" \
	    "\\^done,value=\"off\",verbose=\"AMDGPU precise memory access reporting is off \\(currently disabled\\).\\\\n\",effective-value=\"off\"" \
	    "show precise-memory setting in MI before"

	set cli_effective_value ""
	set mi_effective_value ""
	# Assume precise-memory is available, unless GDB reports otherwise.
	gdb_test_multiple "set amdgpu precise-memory on" "" {
	    -re -wrap "warning: AMDGPU precise memory access reporting could not be enabled\\." {
		set cli_effective_value "disabled"
		set mi_effective_value "off"
		pass $gdb_test_name
	    }
	    -re -wrap "^" {
		set cli_effective_value "enabled"
		set mi_effective_value "on"
		pass $gdb_test_name
	    }
	}

	if {$cli_effective_value eq "" || $mi_effective_value eq ""} {
	    return
	}

	gdb_test "show amdgpu precise-memory" \
	    "AMDGPU precise memory access reporting is on \\(currently ${cli_effective_value}\\)\\." \
	    "show precise-memory setting in CLI after"
	gdb_test "interpreter-exec mi \"-gdb-show amdgpu precise-memory\"" \
	    "\\^done,value=\"on\",verbose=\"AMDGPU precise memory access reporting is on \\(currently ${cli_effective_value}\\).\\\\n\",effective-value=\"${mi_effective_value}\"" \
	    "show precise-memory setting in MI after"

	if { $cli_effective_value eq "disabled" } {
	    return
	}

	# Get to the beginning of the GPU kernel without precise memory enabled.
	with_test_prefix "goto gpu code" {
	    gdb_test_no_output "set amdgpu precise-memory off"
	    gdb_breakpoint "kernel" -allow-pending
	    gdb_test "continue" "Thread ${::decimal}.* hit Breakpoint .*"
	    gdb_test_no_output "set amdgpu precise-memory on"
	}

	# If precise-memory is available, run until a SIGSEGV is reported.
	# The PC then points at or just after the faulting instruction,
	# depending on the XNACK mode (see below).
	gdb_test "continue" "Thread ${::decimal}\[^\r\n\]* received signal SIGSEGV, Segmentation fault.*"

	# The violation is reported at a different point depending on the
	# XNACK mode.  With XNACK enabled the wave stops on the faulting
	# scalar load itself; without it, on the following s_nop.  Pick the
	# expected instruction accordingly instead of accepting both
	# everywhere, which would hide a regression.
	if { [hip_device_xnack_on] } {
	    set expected_insn "s_load_dword\[^\r\n\]*"
	} else {
	    set expected_insn "s_nop\[ \t\]+0"
	}
	gdb_test "x/i \$pc" \
	    "=> ${::hex} <_Z6kernelv\\+${::decimal}>:\[ \t\]+$expected_insn"
    }
}

do_test
