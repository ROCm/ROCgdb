# Test that the
#
#   set amdgpu precise-memory
#   set amdgpu precise-alu-exceptions
#   set lds-exception
#
# settings are inherited by an inferior created following an exec.

load_lib rocm.exp

require allow_hip_tests

standard_testfile .c

if {[build_executable "failed to prepare $testfile" $testfile $srcfile {debug}]} {
    return
}

proc do_test { follow-exec-mode } {
    clean_restart
    gdb_load $::binfile

    with_rocm_gpu_lock {
	if {![runto_main]} {
	    return
	}

	# Check that the properties are off (default).
	foreach property {precise-memory precise-alu-exceptions \
			  lds-exception} {
	    gdb_test "show amdgpu $property" " is off.*" \
		"show amdgpu $property before set"
	}

	# Set the properties on for the inferior before exec.
	foreach property {precise-memory precise-alu-exceptions \
			  lds-exception} {
	    gdb_test "set amdgpu $property on"
	    gdb_test "show amdgpu $property" " is on.*" \
		"show amdgpu $property after set"
	}

	# Continue past exec.  The settings should still be on.
	gdb_test_no_output "set follow-exec-mode ${follow-exec-mode}"
	gdb_test "break second"
	gdb_test "continue" "Breakpoint 1(\.$::decimal)?, main .*"
	foreach property {precise-memory precise-alu-exceptions \
			  lds-exception} {
	    gdb_test "show amdgpu $property" " is on.*" \
		"show amdgpu $property after exec"
	}
    }
}

foreach_with_prefix follow-exec-mode {same new} {
    do_test ${follow-exec-mode}
}
