# Test that the runtime can generate core dumps when running under GDB.
# This is distinct from runtime-core.exp, which tests general core dump
# generation.  This test verifies that when a GPU kernel aborts while
# being debugged, the runtime still produces both host and GPU cores,
# and that the merged core can be loaded with a visible GPU wave showing
# the abort signal.

load_lib rocm.exp

require allow_rocm_core_tests
require allow_hip_tests
# Debug behavior with optimized device code is unreliable; ideally this
# test should be made to work with optimization as well.
require no_optimized_code

standard_testfile .cpp

if { [build_executable "failed to prepare" ${testfile} ${srcfile} \
      {debug hip}] } {
    return -1
}

set coredir [standard_output_file "coredir"]
# Ensure truly clean state by removing and recreating the directory.
file delete -force $coredir
remote_exec build "mkdir -p $coredir"

clean_restart $::testfile
gdb_test "handle SIGABRT nostop pass" \
    "Signal\\s+Stop\\s+Print\\s+Pass.*SIGABRT\\s+No\\s+Yes\\s+Yes.*"
gdb_test_no_output "set cwd $coredir" "set inferior working directory"

with_rocm_gpu_lock {
    # Ensure the test uses default ROCm core dump naming (core.<pid> and
    # core.<pid>.gpu) by unsetting HSA_COREDUMP_PATTERN if it exists.
    save_vars { ::env(HSA_COREDUMP_PATTERN) } {
	unset -nocomplain ::env(HSA_COREDUMP_PATTERN)

	# Wait for program to crash and cores to be written.  This can take
	# a while for large core dumps.
	with_timeout_factor 3 {
	    gdb_test_multiple "run" "wait for program exit" {
		-re "Program received signal SIGABRT.*\r\n" {
		    exp_continue
		}
		-re "The program no longer exists\\.\r\n" {
		    pass $gdb_test_name
		}
	    }
	}

	set allcore_list [glob -nocomplain -directory $coredir "core*"]
	set gpucore_list {}
	set hostcore_list {}

	foreach core $allcore_list {
	    if {[string match "*.gpu" $core]} {
		lappend gpucore_list $core
	    } else {
		lappend hostcore_list $core
	    }
	}

	# If the core count is wrong, mark as unsupported rather than fail.
	# This handles environments where core dump generation is not properly
	# configured.
	if {[llength $gpucore_list] != 1} {
	    unsupported "single GPU core file must exist (found [llength $gpucore_list])"
	    return
	}

	if {[llength $hostcore_list] != 1} {
	    unsupported "single host core file must exist (found [llength $hostcore_list])"
	    return
	}

	set gpucore [lindex $gpucore_list 0]
	set hostcore [lindex $hostcore_list 0]

	set coremerge [gdb_find_coremerge]
	set merged_core "$coredir/merged.core"
	set coremerge_result \
	    [remote_exec build "$coremerge $merged_core $hostcore $gpucore"]
	set coremerge_status [lindex $coremerge_result 0]
	set coremerge_output [lindex $coremerge_result 1]

	if {$coremerge_status != 0 \
		|| ![remote_file build exists $merged_core]} {
	    verbose -log "coremerge failed (status $coremerge_status): $coremerge_output"
	    unsupported "coremerge failed"
	    return
	}

	clean_restart $::testfile
	gdb_test "target core $merged_core" \
	    [multi_line \
		".*" \
		"Core was generated by .*" \
		"Program terminated with signal SIGABRT.*" \
		"Thread $::decimal \\(AMDGPU Wave \[^\r\n\]*\\).*"] \
	    "load merged corefile with GPU wave showing SIGABRT"
    }
}
