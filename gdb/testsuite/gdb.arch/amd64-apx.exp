# Test Intel APX dword, word, byte and raw registers.

proc get_reg_val { type r } {
    set hexr [format %x [expr {$r - 16}]]
    switch $type {
	"d"  { return 0x${hexr}4${hexr}3${hexr}2${hexr}1 }
	"w"  { return 0x${hexr}2${hexr}1 }
	"l"  { return 0x${hexr}1 }
	""   { return 0x00000000${hexr}4${hexr}3${hexr}2${hexr}1 }
    }
}

proc check_reg_content { type } {
    for { set r 16 } { $r <= 31  } { incr r } {
	set regval [get_reg_val $type $r]
	gdb_test "print/z \$r$r$type" "= $regval"
    }
}

require allow_apx_tests

standard_testfile

if { [prepare_for_testing "failed to prepare" ${testfile} ${srcfile} \
	{debug additional_flags=-mapxf}] } {
    return
}

if { ![runto_main] } {
    return
}

set line [gdb_get_line_number "break here"]
gdb_breakpoint $line
gdb_continue_to_breakpoint "break here" ".*$srcfile:$line.*"

# Run test for dword, word, byte pseudo registers, as well as raw registers.
set regtypes [list  "d" "w" "l" ""]
set regtype_names [list  "dword" "word" "byte" "raw"]

# Check initial register content written by testprogram.
foreach type $regtypes type_name $regtype_names {
    with_test_prefix "$type_name register" {
	check_reg_content $type
    }
}

# Check writing registers with GDB.
for { set i 0 } { $i < [llength $regtypes] } { incr i } {
    set type [lindex $regtypes $i]
    set type_name [lindex $regtype_names $i]
    with_test_prefix "$type_name register" {
	for { set r 16 } { $r <= 31  } { incr r } {
	    set val [expr {($r - 16) + $i}]
	    gdb_test_no_output "set var \$r$r$type = $val"
	    gdb_test "print \$r$r$type" "= $val"
	}
    }
}

# Restart gdb, load the core file generated by gcore or the OS
# and check reading the registers from the core file.

proc test_apx_corefiles {core_filename} {
    clean_restart $::testfile

    gdb_test "core $core_filename" "Core was generated by .*" \
	"load core file"

    for { set r 16 } { $r <= 31  } { incr r } {
	set hexr [format %x [expr {$r-16}]]
	gdb_test "print/z \$r$r" \
	    "= 0x00000000${hexr}4${hexr}3${hexr}2${hexr}1"
    }
}

with_test_prefix "OS generated core file" {
    # This test relies on reading address zero triggering a SIGSEGV.
    # If address zero is readable skip this test.
    if { [is_address_zero_readable] } {
	unsupported "address zero is readable"
    } else {
	set corefile [core_find $binfile]
	if { $corefile eq "" } {
	    unsupported "unable to generate core file"
	} else {
	    test_apx_corefiles $corefile
	}
    }
}

with_test_prefix "gcore core file" {
    clean_restart ${::testfile}
    if { ![runto_main] } {
	return
    }

    set line [gdb_get_line_number "break here"]
    gdb_breakpoint $line
    gdb_continue_to_breakpoint "break here" ".*$srcfile:$line.*"

    set gcorefile $binfile.gcore
    if { [gdb_gcore_cmd $gcorefile "save a core file"] } {
	test_apx_corefiles $gcorefile
    }
}
