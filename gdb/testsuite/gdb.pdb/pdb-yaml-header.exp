# A TPI header (stream 2) whose type index range is inverted, larger than
# its record bytes can hold, or not based at 0x1000 is rejected before
# anything is allocated for it, and GDB keeps running.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile

foreach_with_prefix stream {2} {
    foreach_with_prefix range {{4096 4095} {4096 2147483647}
			       {4096 4294967295} {8192 8192}} {
	set exe [standard_output_file \
		     "stream-$stream-range-[join $range -]/header.exe"]
	if {![pdb_prepare_yaml pdb-yaml-onefunc $exe]} {
	    continue
	}

	# TypeIndexBegin and TypeIndexEnd follow Version and HeaderSize at
	# the start of the stream.
	set pdb [file join [file dirname $exe] pdb-yaml-stub.pdb]
	lassign [pdb_test_stream $pdb $stream] block_size blocks data
	set channel [open $pdb r+b]
	seek $channel [expr {[lindex $blocks 0] * $block_size + 8}]
	puts -nonewline $channel [binary format ii {*}$range]
	close $channel

	clean_restart
	disable_pdb_symbol_server
	gdb_test "file [host_file_normalize $exe]" \
	    ".*invalid type index range.*" "header is rejected"
	gdb_test "print 1 + 1" " = 2" "GDB keeps running"
    }
}
