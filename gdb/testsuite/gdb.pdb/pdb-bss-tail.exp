# A global in the uninitialized tail of .data, past the bytes .data has in
# the file, as lld links .bss, still gets the minimal symbol of its public:
# the reader measures the section by its virtual size, not the raw size
# BFD gives an initialized section.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile .c
set exe ${binfile}.exe

if {[pdb_prepare_for_testing "prepare fixture" [file tail $exe] \
	 $srcfile {debug optimize=-O0}]} {
    return
}

gdb_test_lines "maintenance print msymbols" \
    "the global past the file bytes of .data has a minimal symbol" \
    "\\\] D $hex zero_b section \\.data"
