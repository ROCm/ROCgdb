# A program Microsoft cl compiled gets its PDB loaded, whether the HIP
# SDK's lld-link or Microsoft link wrote the PDB.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile pdb-test.cpp

foreach_with_prefix linker {lld link} {
    pdb_cl_prepare_for_testing "prepare fixture" ${binfile}-${linker}.exe \
	$srcdir/$subdir/$srcfile c++ /Od $linker
}
