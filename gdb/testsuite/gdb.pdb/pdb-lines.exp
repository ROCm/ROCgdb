# A PDB's line tables: a source line maps to its code and an address to
# its line, for a line breakpoint and "list".  The program is built with
# /Gy, which gives every function a section contribution of its own while
# the module header names only the first, by the selected board and by
# Microsoft cl linked by Microsoft link.  The selftests cover the rows
# themselves.
# The functions are named by their public symbols; later readers give
# them full symbols, which the patterns also accept.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile .c

set first_line [gdb_get_line_number "first body"]
set second_line [gdb_get_line_number "second body"]
set main_line [gdb_get_line_number "main body"]

# Check the lines of the program GDB has loaded.

proc check_lines {} {
    global srcfile first_line second_line main_line hex decimal

    set file "\"\[^\r\n\]*[string_to_regexp $srcfile]\""
    # A full symbol shows its parameter list.
    set params "(\\(int\\)|\\(void\\)|\\(\\))?"
    foreach {func line} [list first $first_line second $second_line \
			     main $main_line] {
	gdb_test "info line $srcfile:$line" \
	    "Line $line of $file starts at address $hex <${func}${params}\\+$decimal> and ends at $hex <${func}.*>\\." \
	    "line $line of $func maps to its code"
	gdb_test "info line *$func" \
	    "Line $decimal of $file starts at address $hex <${func}${params}> and ends at .*" \
	    "$func's address maps to a line"
    }

    gdb_test "break $srcfile:$second_line" \
	"Breakpoint $decimal at $hex: file \[^\r\n\]*[string_to_regexp $srcfile], line $second_line\\." \
	"a line breakpoint in second"
    gdb_test "list $srcfile:$main_line,$main_line" \
	"$main_line\[ \t\]+return first \\(1\\) \\+ second \\(2\\);.*" \
	"list the line of main"
}

# The board's build and Microsoft cl's linked by Microsoft link, with
# /Gy: the layouts of section contributions per function.
with_test_prefix "board" {
    if {[pdb_prepare_for_testing "prepare fixture" ${testfile}.exe $srcfile \
	     {debug optimize=-O0 additional_flags=-Gy}] == 0} {
	check_lines
    }
}

with_test_prefix "cl" {
    if {[pdb_cl_prepare_for_testing "prepare fixture" ${binfile}-cl.exe \
	     $srcdir/$subdir/$srcfile c "/Od /Gy" link] == 0} {
	check_lines
    }
}
