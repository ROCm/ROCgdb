# Test "symbol-file -readnever" on a program with a PDB.  GDB still loads
# the PDB, because its public symbols are the program's minimal symbols:
# lld-link writes no COFF symbol table.  It reads no symbol table.

load_lib lib-pdb.exp

require !readnow

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile pdb-test.cpp

if {[pdb_prepare_for_testing "prepare fixture" ${testfile}.exe $srcfile \
	 {debug c++ optimize=-O0}] != 0} {
    return
}

clean_restart
gdb_test "symbol-file -readnever ${binfile}.exe" \
    "Reading symbols from .*" \
    "load the program with -readnever"

gdb_test "maintenance info pdb-loaded-files" \
    ".*[string_to_regexp $testfile.pdb]" \
    "the PDB is loaded"
gdb_test_no_output "maintenance info symtabs" \
    "no symbol table is read"
gdb_test "info address main" \
    "Symbol \"main\" is at $hex in a file compiled without debugging\\." \
    "main is a minimal symbol"
