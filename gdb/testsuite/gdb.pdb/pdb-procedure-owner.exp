# A procedure type returning a builtin belongs to the objfile, as its
# parameters can, so a copy kept by Python outlives the objfile.

load_lib lib-pdb.exp

require allow_python_tests

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile
set exe ${binfile}.exe

if {![pdb_prepare_yaml pdb-yaml-onefunc $exe]} {
    return
}

clean_restart [file tail $exe]
disable_pdb_symbol_server

gdb_test_no_output \
    "python procedure = gdb.lookup_global_symbol('gfunc').type; owner = procedure.objfile" \
    "keep the procedure type"
gdb_test "python print(owner is not None)" "True" \
    "the procedure type belongs to the objfile"
gdb_test "python print(procedure)" "int \\(int\\)" \
    "procedure type before the unload"
gdb_test "symbol-file" "" "unload the symbols" \
    "Discard symbol table from .*" "y"
gdb_test "python print(owner.is_valid())" "False" \
    "the objfile is gone"
gdb_test "python print(procedure)" "int \\(int\\)" \
    "the kept procedure type survives"
gdb_test "python print(procedure.objfile is None)" "True" \
    "the kept procedure type no longer belongs to the objfile"
