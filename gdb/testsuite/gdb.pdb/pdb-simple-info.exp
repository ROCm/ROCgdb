# Test PDB debugging: breakpoints, stepping, public symbols, info commands.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

# The fixtures are Windows executables, so starting one needs a native host.
require isnative

standard_testfile pdb-test.cpp

set exe ${binfile}.exe
if {[pdb_prepare_for_testing "prepare fixture" [file tail $exe] \
     $srcfile {debug c++ optimize=-O0}]} {
    return
}

set srcfile_re [string_to_regexp $srcfile]

# Check that "info functions" lists only the debug function NAME, from
# the test's source file.  A C++ function's name includes its parameter
# list, so the regexp ends at the end of a word.
proc check_info_function {name testname} {
    global srcfile_re

    gdb_test "info functions -n ^${name}\\>" \
	[multi_line \
	     "All functions matching regular expression \"\\^${name}\\\\>\":" \
	     "" \
	     "File \[^\r\n\]*${srcfile_re}:" \
	     "\t\[^\r\n\]*\\m${name}\\(\[^\r\n\]*\\);"] \
	$testname
}

# Increase expect buffer: unfiltered info commands can produce
# more output than the default 16 KB.  Never lower the board's.
if {[match_max] < 131072} {
    match_max 131072
}

# info sources: should mention the source file
gdb_test "info sources" \
    ".*${srcfile_re}.*" \
    "info sources lists $srcfile"

# Line tables and public symbols are enough for source-level control: a stop
# and the backtrace show file:line, and 'list', 'next' and 'step' work by
# line.  A global is reached through its public symbol.
with_test_prefix "source level" {
    set main_line [gdb_get_line_number "volatile int local_int = 42;"]
    set call_line [gdb_get_line_number "int sum = compute1 (local_int, 10, adder);"]
    set callee_line [gdb_get_line_number "constexpr int shadow_const = 11;"]

    gdb_breakpoint "main"
    gdb_run_cmd
    gdb_test "" "main \\(\\) at \[^\r\n\]*${srcfile_re}:$main_line\r\n$main_line\t.*" \
	"stop at main shows file:line"
    gdb_test "backtrace" "#0 +main \\(\\) at \[^\r\n\]*${srcfile_re}:$main_line" \
	"backtrace shows file:line"
    gdb_test "info line *\$pc" "Line $main_line of \"\[^\"\]*${srcfile_re}\" .*" \
	"info line at the stop"
    gdb_test "list $main_line,$main_line" \
	"$main_line\[ \t\]+volatile int local_int = 42;" \
	"list the stop line"
    gdb_test "next" "[expr {$main_line + 1}]\[ \t\]+double local_double = 3\\.14;" \
	"next goes to the following line"

    gdb_breakpoint "$srcfile:$call_line"
    gdb_continue_to_breakpoint "the call to compute1" \
	".*${srcfile_re}:$call_line\r\n.*"
    gdb_test "step" "$callee_line\[ \t\]+constexpr int shadow_const = 11;" \
	"step into compute1"
    gdb_test "backtrace" \
	"#0 \[^\r\n\]* at \[^\r\n\]*${srcfile_re}:$callee_line\r\n#1 \[^\r\n\]*main \\(\\) at \[^\r\n\]*${srcfile_re}:$call_line" \
	"backtrace in compute1"
    gdb_test "finish" \
	[multi_line \
	     "Run till exit from #0 \[^\r\n\]*compute1\\M\[^\r\n\]*" \
	     "\[^\r\n\]*main \\(\\) at \[^\r\n\]*${srcfile_re}:$call_line" \
	     "$call_line\t\[^\r\n\]*compute1 \\(local_int, 10, adder\\);.*"] \
	"finish to main"

    gdb_test "x/i \$pc" "=> $hex <\[^\r\n\]*>:\t.*" "disassemble at the pc"
    gdb_test "print &g_counter" " = \\(\[^\r\n\]*\\*\\) $hex <g_counter>" \
	"address of a global"
    gdb_test "print (int) g_counter" " = 3" "global through a cast"

    delete_breakpoints
}

# info functions
check_info_function main "info functions lists main"

# A procedure record names its LF_PROCEDURE signature in the TPI.
gdb_test "info functions add_values" \
    "File \[^\r\n\]*${srcfile_re}:\r\n\tint add_values\\(int, int\\);" \
    "info functions add_values"
gdb_test "ptype main" "type = int \\(void\\)"
gdb_test "ptype add_values" "type = int \\(int, int\\)"
gdb_test "whatis static_helper" "type = int \\(int, int\\)"

check_info_function compute1 "info functions compute1"
check_info_function static_helper "info functions static_helper (file-static)"
check_info_function process_point "info functions process_point"
check_info_function modify_volatile "info functions modify_volatile"

# fast_abs is __forceinline, so its only call is inlined and it has no
# procedure record of its own.
gdb_test "info functions -n ^fast_abs\\>" \
    "All functions matching regular expression \"\\^fast_abs\\\\>\":" \
    "info functions fast_abs lists nothing"
