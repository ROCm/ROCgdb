# A module with line blocks but no DEBUG_S_FILECHKSMS subsection: its rows
# keep their lines under an unknown file, and reading them prints nothing.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

set testfile pdb-yaml-nochecksums
standard_testfile

set exe ${binfile}.exe

if {![pdb_prepare_yaml pdb-yaml-modbounds $exe 2]} {
    return
}

# yaml2pdb cannot write line blocks without their checksums, so hide the
# checksums of module A after generation.
set pdb [file join [file dirname $exe] pdb-yaml-stub.pdb]
if {[catch {exec python3 -B $srcdir/$subdir/pdb-yaml-setsc.py \
		$pdb hide 0xf4 0 2>@1} output]} {
    perror "cannot hide the checksums: $output"
    return
}

clean_restart
disable_pdb_symbol_server

# Every module is expanded while the file loads.
gdb_test "file $exe" \
    "Reading symbols from \[^\r\n\]*\\.\\.\\.(\r\nExpanding full symbols from \[^\r\n\]*\\.\\.\\.)?" \
    "load prints nothing about the missing checksums"

gdb_test_no_output "maintenance expand-symtabs" "expand the modules"

gdb_test "info line *0x140001000" \
    "Line 10 of \"<unknown>\" starts at address 0x140001000\[^\r\n\]*" \
    "a row without its file keeps its line"
