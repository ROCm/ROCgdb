# A procedure type that is its own return type gets an unsupported return
# type instead of recursing without end.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

standard_testfile
set exe ${binfile}.exe

if {![pdb_prepare_yaml pdb-yaml-proccycle $exe]} {
    return
}

clean_restart [file tail $exe]
disable_pdb_symbol_server

gdb_test "ptype selfret" \
    "type = <unsupported PDB type> \\(void\\)" \
    "a procedure returning itself"
gdb_test "print 1 + 1" " = 2" "GDB keeps running"
