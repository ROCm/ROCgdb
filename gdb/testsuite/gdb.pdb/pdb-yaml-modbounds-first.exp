# A module with one procedure claims no PC outside it.  Module B comes
# first and its section contribution covers module A's procedures.

load_lib lib-pdb.exp

if {![pdb_support]} {
    unsupported "PDB not supported on this target"
    return
}

set testfile pdb-yaml-modbounds-first
standard_testfile

set exe ${binfile}.exe

if {![pdb_prepare_yaml $testfile $exe 2]} {
    return
}

clean_restart [file tail $exe]
disable_pdb_symbol_server

gdb_test_no_output "maintenance expand-symtabs" "expand the modules"

gdb_test "info line *0x140001000" \
    "Line 10 of \"\[^\"\]*pdb-yaml-modbounds-a\\.cpp\" starts at address .*" \
    "A's first procedure is in A"

gdb_test "info line *0x140001080" \
    "Line 30 of \"\[^\"\]*pdb-yaml-modbounds-b\\.cpp\" starts at address .*" \
    "B's procedure is in B"

gdb_test "info line *0x140001100" \
    "Line 20 of \"\[^\"\]*pdb-yaml-modbounds-a\\.cpp\" starts at address .*" \
    "A's last procedure is in A"
