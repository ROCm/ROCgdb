require allow_cplus_tests

### The demangling style we last sent to GDB.
set current_demangling_style none

### Set GDB's current demangling style to STYLE.  Subsequent calls to
### test_demangle will include STYLE in the test name when reporting
### passes and failures.
proc set_demangling_style {style} {
    global gdb_prompt
    global current_demangling_style

    gdb_test_multiple "set demangle-style $style" \
	"$style: set demangle-style" {
	    -re "set demangle-style $style\[\r\n\]+$gdb_prompt $" {
		pass "$style: set demangle-style"
	    }
	    -re ".*$gdb_prompt $" {
		fail "$style: set demangle-style"
		error "set_demangling_style: set style"
	    }
	    timeout {
		fail "$style: set demangle-style (timeout)"
		error "set_demangling_style: set style"
	    }
	}

    gdb_test_multiple "show demangle-style" \
	"$style: check demangling style" {
	    -re "The current C\[+\]+ demangling style is \"$style\".\r\n$gdb_prompt $" {
		pass "$style: check demangling style"
	    }
	    -re ".*$gdb_prompt $" {
		fail "$style: check demangling style"
		error "set_demangling_style: check style"
	    }
	    timeout {
		fail "$style: check demangling style (timeout)"
		error "set_demangling_style: check style"
	    }
	}

    set current_demangling_style $style
}


### Utility function for test_demangling and test_demangling_exact.
proc test_demangling_core {tester test result} {
    global current_demangling_style

    if {! [regexp {^([^ ]+): (.+)$} $test dummy style name]} {
      error "bad test name passed to test_demangling"
    }

    if {[string compare $style $current_demangling_style]} {
	with_test_prefix $test {
	    set_demangling_style $style
	}
    }

    $tester "demangle $name" $result $test
}

### Demangle an identifier, and check that the result matches a pattern.
###
### TEST should be of the form "STYLE: NAME", where STYLE is the name
### of a demangling style (like "gnu" or "arm"), and NAME is a mangled
### identifier to demangle.  Pass when the result matches the regular
### expression RESULT.  Report passes and fails using TEST as the name
### of the test.
###
### Why don't we just pass the STYLE and NAME as two separate
### arguments, or let the style be a global variable?  That would be
### cleaner.  However, doing it this way means that:
###
### 1) the name of the test, as recorded in the summary and log,
### appears verbatim in the script, and
###
### 2) that test names are unique, even though we try to demangle the same
### identifiers using several different mangling styles.
###
### This makes it a lot easier for people tracking down failures to
### find the one they care about.

proc test_demangling {test result} {
    test_demangling_core gdb_test $test $result
}

### Like test_demangling, above, except that RESULT is not a regexp,
### but a string that must match exactly.

proc test_demangling_exact {test result} {
    test_demangling_core gdb_test_exact $test $result
}

#
#  Test gnu-v3 style name demangling
#

proc test_gnuv3_style_demangling {} {
    global gdb_prompt

    # Rvalue reference tests
    test_demangling_exact "gnu-v3: _ZN9ArrowLine19ArrowheadIntersectsEP9ArrowheadO6BoxObjP7Graphic" "ArrowLine::ArrowheadIntersects(Arrowhead*, BoxObj&&, Graphic*)"
    test_demangling "gnu-v3: _Z13BitPatterntoaOK10BitPatternccc" \
	"BitPatterntoa\[(\]+(const BitPattern|BitPattern const)&&, char, char, char\[)\]+"
    test_demangling_exact "gnu-v3: _ZN8TextCode14CoreConstDeclsEO7ostream" "TextCode::CoreConstDecls(ostream&&)"
    test_demangling "gnu-v3: _Z31DrawDestinationTransformedImageP7_XImageiiS0_iimjiijmmP4_XGCOK13ivTransformeriiii" \
	"DrawDestinationTransformedImage\[(\]+_XImage\[*\]+, int, int, _XImage\[*\]+, int, int, unsigned long, unsigned int, int, int, unsigned int, unsigned long, unsigned long, _XGC\[*\]+, (const ivTransformer|ivTransformer const)&&, int, int, int, int\[)\]+"
    test_demangling_exact "gnu-v3: _ZN11RelateManip6EffectEO7ivEvent" "RelateManip::Effect(ivEvent&&)"
    test_demangling_exact "gnu-v3: _ZN20DisplayList_IteratorC4EO11DisplayList" "DisplayList_Iterator::DisplayList_Iterator(DisplayList&&)"
    test_demangling_exact "gnu-v3: _ZN3fooC4EOS_" "foo::foo(foo&&)"
    test_demangling_exact "gnu-v3: _ZN3fooC4EiOS_iS0_iS0_" "foo::foo(int, foo&&, int, foo&&, int, foo&&)"
    test_demangling "gnu-v3: _ZN7ivWorldC2EPKcOiPPcPK12ivOptionDescPK14ivPropertyData" \
	"ivWorld::ivWorld\[(\]+(const char|char const)\[*\]+, int&&, char\[*\]+\[*\]+, (const ivOptionDesc|ivOptionDesc const)\[*\]+, (const ivPropertyData|ivPropertyData const)\[*\]+\[)\]+"
    test_demangling "gnu-v3: _Z3argOK7Complex" \
	"arg\[(\]+(const Complex|Complex const)&&\[)\]+"
    test_demangling "gnu-v3: _ZNK9BitString8containsEOK10BitPattern" \
	"BitString::contains\[(\]+(const BitPattern|BitPattern const)&&\[)\]+ const"
    test_demangling "gnu-v3: _ZNK9BitString8containsEOK12BitSubStringi" \
	"BitString::contains\[(\]+(const BitSubString|BitSubString const)&&, int\[)\]+ const"
    test_demangling "gnu-v3: _ZNK9BitString8containsEOKS_" \
	"BitString::contains\[(\]+(const BitString|BitString const)&&\[)\]+ const"
    test_demangling_exact "gnu-v3: _ZN4ListI10VHDLEntityE3PixC4EOKS2_" \
	"List<VHDLEntity>::Pix::Pix(List<VHDLEntity>::Pix const&&)"
    test_demangling_exact "gnu-v3: _ZN4ListI10VHDLEntityE7elementC2EOKS0_PS2_" \
	"List<VHDLEntity>::element::element(VHDLEntity const&&, List<VHDLEntity>::element*)"
    test_demangling_exact "gnu-v3: _ZN4ListI10VHDLEntityE7elementC4EOKS2_" \
	"List<VHDLEntity>::element::element(List<VHDLEntity>::element const&&)"
    test_demangling_exact "gnu-v3: _ZNK4ListI10VHDLEntityEclEOKNS1_3PixE" \
	"List<VHDLEntity>::operator()(List<VHDLEntity>::Pix const&&) const"
    test_demangling_exact "gnu-v3: _ZN4ListI10VHDLEntityEC4EOKS1_" \
	"List<VHDLEntity>::List(List<VHDLEntity> const&&)"
    test_demangling_exact "gnu-v3: _ZN4PixXI11VHDLLibrary14VHDLLibraryRep4ListI10VHDLEntityEEC2EOKS5_" \
	"PixX<VHDLLibrary, VHDLLibraryRep, List<VHDLEntity> >::PixX(PixX<VHDLLibrary, VHDLLibraryRep, List<VHDLEntity> > const&&)"
    test_demangling_exact "gnu-v3: _ZNK11VHDLLibrary5nextEEO4PixXIS_14VHDLLibraryRep4ListI10VHDLEntityEE" \
	"VHDLLibrary::nextE(PixX<VHDLLibrary, VHDLLibraryRep, List<VHDLEntity> >&&) const"
    test_demangling_exact "gnu-v3: _ZNK4ListI10VHDLEntityE4nextEONS1_3PixE" \
	"List<VHDLEntity>::next(List<VHDLEntity>::Pix&&) const"
}

#
# Test MSVC name demangling.
#
# These exercise libiberty's cplus_demangle dispatching to msvc_demangle,
# which is registered by bfd_init when GDB is built with the MSVC
# demangler enabled (auto-enabled for Windows/PE targets).  Symbols
# starting with '?' are unambiguously MSVC-mangled.
#

proc test_msvc_demangling {} {
    if {![gdb_msvc_demangler_built]} {
	unsupported "MSVC demangler not built in"
	return
    }

    # Switch to auto style so that '?'-prefixed names are dispatched
    # to the MSVC handler.
    with_test_prefix "msvc-auto" {
	set_demangling_style "auto"

	# Basic free function and template.
	gdb_test_exact "demangle ?foo@@YAXXZ" "foo()"
	gdb_test_exact "demangle ?bar@@YAHDH@Z" "bar(char, int)"
	gdb_test_exact "demangle ??\$func@H@@YAHH@Z" "func<int>(int)"
	gdb_test_exact "demangle ?v_int_typedef@@3HA" "v_int_typedef"

	# Member function on class.
	gdb_test_exact "demangle ?m1@C@@QAEXXZ" "C::m1()"

	# Calling-convention variant (default formatting omits __stdcall).
	gdb_test_exact "demangle ?stdcallFunc@@YGXXZ" "stdcallFunc()"

	# Function-pointer parameter.
	gdb_test_exact "demangle ?callback@Cb@@QEAAXP6AXH@Z@Z" \
	    "Cb::callback(void (*)(int))"

	# MSVC's sized integer types are the builtin types; size_t is
	# unsigned __int64.
	gdb_test_exact "demangle ?f@@YAX_J@Z" "f(long long)"
	gdb_test_exact "demangle ?f@@YAX_K@Z" "f(unsigned long long)"
	gdb_test_exact "demangle ?f@@YAXH_J@Z" "f(int, long long)"
	gdb_test_exact "demangle ?g@@YAXPEB_J@Z" "g(long long const *)"
	gdb_test_exact \
	    "demangle ??A?\$basic_string@DU?\$char_traits@D@std@@V?\$allocator@D@2@@std@@QEAAAEAD_K@Z" \
	    "std::basic_string<char, std::char_traits<char>, std::allocator<char>>::operator\[\](unsigned long long)"

	# Dropping class/struct/enum leaves no space after the bracket.
	gdb_test_exact "demangle ?f@@YAXAEBVA@@@Z" "f(A const &)"
	gdb_test_exact "demangle ?f@@YAXW4E@@@Z" "f(E)"
	gdb_test_exact "demangle ?f@@YAXPEAU?\$X@US@@@@@Z" "f(X<S> *)"

	# Anonymous namespace, in GDB's spelling.
	gdb_test_exact "demangle ?xx@?A0x965E6BB6@A@@3HA" \
	    "A::(anonymous namespace)::xx"

	# A vcall thunk, alone and as a member-pointer template argument.
	gdb_test_exact "demangle ??_9A@@\$BA@AA" "\[thunk\]: A::`vcall'{0, {flat}}"
	gdb_test_exact \
	    "demangle ??\$As@_K@?\$LazyOffsetPtr@VB@@_K\$H??_9A@@\$BDA@AAA@@@QEBAAEA_K_N@Z" \
	    "LazyOffsetPtr<B, unsigned long long, {\[thunk\]: A::`vcall'{48, {flat}}, 0}>::As<unsigned long long>(bool) const"

	# A conversion operator template instance, in GDB's spelling.
	gdb_test_exact "demangle ??\$?BH@conv@@QEBAPEAHXZ" \
	    "conv::operator int *<int>() const"

	# A compiler-added suffix, as for Itanium names.
	gdb_test_exact "demangle ?split_fn@@YAHH@Z.cold.1" \
	    "split_fn(int) \[clone .cold.1\]"

	# An operator< template instance is not operator<<.
	gdb_test_exact \
	    "demangle ??\$?MV?\$Empty@H@@@@YAHAEAV?\$Empty@H@@0@Z" \
	    "operator< <Empty<int>>(Empty<int> &, Empty<int> &)"

	# Structors of a class template instance are named without the
	# class's template arguments; a constructor template keeps its own.
	gdb_test_exact "demangle ??0?\$tpl@HM@@QEAA@XZ" "tpl<int, float>::tpl()"
	gdb_test_exact "demangle ??1?\$tpl@HM@@QEAA@XZ" \
	    "tpl<int, float>::~tpl()"
	gdb_test_exact "demangle ??\$?0H@T@@QEAA@H@Z" "T::T<int>(int)"

	# A parameter's top-level const is not part of the signature.
	gdb_test_exact "demangle ?f@@YAXQEAD@Z" "f(char *)"

	# Only the symbol's own return type is left out, not those of the
	# function types in its parameters.
	gdb_test_exact "demangle ?hairyfunc5@@YAHP6AP6AHJ@ZPEAD@Z@Z" \
	    "hairyfunc5(int (* (*)(char *))(long))"

	# A function's static local is named "FUNCTION::NAME".
	gdb_test_exact \
	    "demangle ?s_var@?1??inline_method@S@@QEAAXXZ@4HA" \
	    "S::inline_method()::s_var"
	gdb_test_exact "demangle ?x@?BA@??f@@YAHH@Z@4HA" "f(int)::x"

	# The function of a static local is spelled as the function's own
	# demangled name.
	foreach {func demangled} {
	    {??$?BH@conv@@QEBAPEAHXZ} {conv::operator int *<int>() const}
	    {??$?MV?$Empty@H@@@@YAHAEAV?$Empty@H@@0@Z}
	    {operator< <Empty<int>>(Empty<int> &, Empty<int> &)}
	    {??0?$tpl@HM@@QEAA@XZ} {tpl<int, float>::tpl()}
	    {??1?$tpl@HM@@QEAA@XZ} {tpl<int, float>::~tpl()}
	    {??$?0H@T@@QEAA@H@Z} {T::T<int>(int)}
	    {?f@@YAXQEAD@Z} {f(char *)}
	    {?hairyfunc5@@YAHP6AP6AHJ@ZPEAD@Z@Z}
	    {hairyfunc5(int (* (*)(char *))(long))}
	    {?f@@YAP6AHH@ZXZ} {f()}
	    {?g@?A0x965E6BB6@A@@YAXXZ} {A::(anonymous namespace)::g()}
	    {?h@@YAX_J@Z} {h(long long)}
	    {?f@@YAXXZ} {f()}
	    {?m@S@@QEBAXXZ} {S::m() const}
	    {?sm@S@@SAXXZ} {S::sm()}
	    {?vm@S@@UEAAXXZ} {S::vm()}
	    {??$tf@H@@YAXH@Z} {tf<int>(int)}
	    {?f@N@@YAXXZ} {N::f()}
	    {?v@@YAXHZZ} {v(int, ...)}
	    {??HA@@QEAAHH@Z} {A::operator+(int)}
	    {?f@@YAXPEBD@Z} {f(char const *)}
	    {?f@@YAXAEAH@Z} {f(int &)}
	} {
	    gdb_test_exact "demangle $func" $demangled "function $func"
	    gdb_test_exact "demangle ?x@?1?$func@4HA" "${demangled}::x" \
		"static local in $func"
	}

	# A local class: a static local of its method, and its static member.
	gdb_test_exact "demangle ?x@?1??m@L@?1??f@@YAXXZ@QEAAXXZ@4HA" \
	    "f()::L::m()::x"
	gdb_test_exact "demangle ?y@L@?1??f@@YAXXZ@2HA" "f()::L::y"

	# A static local of pointer type.
	gdb_test_exact "demangle ?p@?1??f@@YAXXZ@4PEAHEA" "f()::p"

	# Local classes nested in member functions of local classes, as
	# clang emits them; each level is a local scope of its own.
	gdb_test_exact "demangle ?h@L@?2??g@@YAHXZ@SAHXZ" "g()::L::h()"
	gdb_test_exact "demangle ?z@?1??h@L@?1??g@@YAHXZ@SAHXZ@4HA" \
	    "g()::L::h()::z"
	gdb_test_exact "demangle ?k@M@?1??h@L@?2??g@@YAHXZ@SAHXZ@SAHXZ" \
	    "g()::L::h()::M::k()"
	gdb_test_exact \
	    "demangle ?q@?1??k@M@?1??h@L@?1??g@@YAHXZ@SAHXZ@SAHXZ@4HA" \
	    "g()::L::h()::M::k()::q"

	# A static local as a template argument.
	gdb_test_exact "demangle ??\$tf@\$1?a@?2??two@@YAHXZ@4HA@@YAHXZ" \
	    "tf<&two()::a>()"

	# A local scope whose spelling has quotes of its own, scope number
	# zero, and a variable as the scope.
	gdb_test_exact "demangle ?x@?1???__Ev@@YAXXZ@4HA" \
	    "`dynamic initializer for 'v''()::x"
	gdb_test_exact "demangle ?x@?@??f@@YAXXZ@4HA" "f()::x"
	gdb_test_exact "demangle ?x@?1??v@@3HA@4HA" "v::x"
    }

    # Explicit "msvc" style: cplus_demangle passes DMGL_MSVC to the
    # handler, which preserves MSVC-specific decorations (calling
    # conventions, etc.) instead of stripping them.
    with_test_prefix "msvc-style" {
	set_demangling_style "msvc"

	# __cdecl preserved on free functions.
	gdb_test_exact "demangle ?foo@@YAXXZ" "void __cdecl foo(void)"
	gdb_test_exact "demangle ?bar@@YAHDH@Z" \
	    "int __cdecl bar(char, int)"
	gdb_test_exact "demangle ??\$func@H@@YAHH@Z" \
	    "int __cdecl func<int>(int)"
	gdb_test_exact "demangle ?v_int_typedef@@3HA" "int v_int_typedef"

	# __stdcall preserved on YG-encoded functions.
	gdb_test_exact "demangle ?stdcallFunc@@YGXXZ" \
	    "void __stdcall stdcallFunc(void)"

	# __thiscall preserved on QAE member functions.
	gdb_test_exact "demangle ?m1@C@@QAEXXZ" \
	    "public: void __thiscall C::m1(void)"

	# Sized integer types keep their MSVC spelling.
	gdb_test_exact "demangle ?f@@YAX_K@Z" \
	    "void __cdecl f(unsigned __int64)"

	# Anonymous namespace, in MSVC's spelling.
	gdb_test_exact "demangle ?xx@?A0x965E6BB6@A@@3HA" \
	    "int A::`anonymous namespace'::xx"

	# A vcall thunk keeps its calling convention.
	gdb_test_exact "demangle ??_9A@@\$BA@AA" \
	    "\[thunk\]: __cdecl A::`vcall'{0, {flat}}"

	# A conversion operator template instance, in MSVC's spelling.
	gdb_test_exact "demangle ??\$?BH@conv@@QEBAPEAHXZ" \
	    "public: int * __cdecl conv::operator<int> int *(void) const"

	# Static locals keep MSVC's "`FUNCTION'::`SCOPE'::" spelling.
	gdb_test_exact "demangle ?x@?1??f@@YAXXZ@4HA" \
	    "int `void __cdecl f(void)'::`2'::x"
	gdb_test_exact "demangle ?x@?1??m@L@?1??f@@YAXXZ@QEAAXXZ@4HA" \
	    "int `public: void __cdecl `void __cdecl f(void)'::`2'::L::m(void)'::`2'::x"
	gdb_test_exact "demangle ?x@?1??g@?A0x965E6BB6@A@@YAXXZ@4HA" \
	    "int `void __cdecl A::`anonymous namespace'::g(void)'::`2'::x"
    }
}

proc catch_demangling_errors {command} {
    if {[catch {$command} result]} {
	puts "ERROR: demangle.exp: while running $command: $result"
    }
}

# Test support for different demangling styles.  Note that this does
# not depend upon running the test program and does not depend upon
# gdb being able to lookup any C++ symbols.  It simply calls the
# internal demangler with synthesized strings and tests the results.

proc do_tests {} {
    global subdir
    global gdb_prompt


    # Start with a fresh gdb.

    gdb_exit
    gdb_start

    gdb_test_no_output "set language c++"
    gdb_test_no_output "set width 0"

    # Using catch_demangling_errors this way ensures that, if one of
    # the functions raises a Tcl error, then it'll get reported, and
    # the rest of the functions will still run.
    catch_demangling_errors test_gnuv3_style_demangling
    catch_demangling_errors test_msvc_demangling

    # Verify specifying demangle language.
    gdb_test_no_output "set language unknown"
    set_demangling_style "auto"
    gdb_test_exact "demangle -l c++ -- _ZSt4cout" "std::cout"
    gdb_test_exact "demangle -l c++ _ZSt4cout" "std::cout"
    gdb_test_exact "demangle -l c -- _ZSt4cout" "Can't demangle \"_ZSt4cout\""
    gdb_test_exact "demangle -l garbage xyzdje" "Unknown language \"garbage\""
}

do_tests
