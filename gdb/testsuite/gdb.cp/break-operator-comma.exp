# Set a breakpoint on a user-defined comma operator with
# "break T::operator,".  The linespec lexer asks the C++ ABI's
# is_operator_name whether the text starting at "operator" names an
# operator; if it does not, the token ends at the ',' and GDB looks
# for "T::operator" instead.  The answer must not depend on the C++
# ABI, so check under each ABI, on the same program.

require allow_cplus_tests

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug c++}]} {
    return
}

if {![runto_main]} {
    return
}

set comma_line [gdb_get_line_number "operator-comma-body"]

foreach_with_prefix abi {gnu-v3 msvc} {
    gdb_test_no_output "set cp-abi $abi"
    delete_breakpoints
    gdb_test "break T::operator," \
	"Breakpoint $decimal at $hex: file .*[string_to_regexp $srcfile], line $comma_line\\."
}

gdb_test_no_output "set cp-abi auto"

gdb_test "continue" \
    "Breakpoint $decimal, .*\r\n$comma_line\[ \t\]+T r;\[^\r\n\]*operator-comma-body.*" \
    "continue to operator,"

gdb_test "print this->t" " = 1"
gdb_test "print o.t" " = 2"
