# Step into calls through pointers to virtual member functions.  GDB
# must stop in the final overrider.  Under the MSVC C++ ABI the call
# goes through a "vcall" thunk, which has no line information, and in
# one case through a this-adjusting thunk after it.

require allow_cplus_tests

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug c++}]} {
    return
}

if {![runto_main]} {
    return
}

# Step into the call at the line marked COMMENT and expect to stop in
# the body of CLASS::METHOD, called from CALLER.  The class qualifier
# is optional in the backtrace because frames of MSVC-ABI programs may
# show only the method name.
proc step_into_vcall {comment class method caller name} {
    with_test_prefix $name {
	gdb_breakpoint [gdb_get_line_number $comment]
	gdb_continue_to_breakpoint "call" ".*[string_to_regexp $comment].*"
	gdb_test "step" ".*[string_to_regexp "${class}::$method body."].*" \
	    "step into ${class}::$method"
	gdb_test "bt 2" \
	    [multi_line \
		 "#0 +(${class}::)?$method \\(this=$::hex\\) at \[^\r\n\]+" \
		 "#1 +$::hex in $caller \\(\[^\r\n\]*\\) at \[^\r\n\]+.*"] \
	    "backtrace"
    }
}

step_into_vcall "Call through S." "D" "g" "call_s" "virtual"
step_into_vcall "Call through B." "M" "h" "call_b" "second base"
step_into_vcall "Call through L." "L" "v17" "call_l" "far slot"
