# Read a virtual base of a class that also has its own virtual
# functions.  Under the MSVC C++ ABI such a class starts with its vfptr
# and the vbptr comes after it; GDB scans the object to locate the vbptr.

require allow_cplus_tests

standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug c++}]} {
    return
}

if {![runto [gdb_get_line_number "Break here."]]} {
    return
}

set msvc_abi 0
gdb_test_multiple "show cp-abi" "" {
    -re -wrap "\\(currently \"msvc\"\\)\\." {
	set msvc_abi 1
	pass $gdb_test_name
    }
    -re -wrap "" {
	pass $gdb_test_name
    }
}

# The virtual base comes through a non-virtual base that has its own
# vbptr.
gdb_test "print gq.v" " = 11" "virtual base through a non-virtual base"
gdb_test "print gq" \
    " = \{<P> = \{<V> = \{v = 11\}, .*p = 33\}, .*qq = 44\}" \
    "print object, virtual base through a non-virtual base"

# The class itself has the vbptr after its vfptr.
gdb_test "print gw.v" " = 11" "virtual base of a class with a vfptr"
gdb_test "print gw" " = \{<V> = \{v = 11\}, .*w = 22\}" \
    "print object, virtual base of a class with a vfptr"

# The class reuses the vbptr of a non-virtual base that is not at
# offset 0.  Under gnu-v3 P has a vptr, hence the ".*" before "p".
gdb_test "print gf.v" " = 11" "shared vbptr after a base, base's vbase"
gdb_test "print gf.b" " = 66" "shared vbptr after a base, own vbase"
gdb_test "print gf" \
    " = \{<X> = \{.*xx = 55\}, <W> = \{<V> = \{v = 11\}, .*w = 22\}, <B> = \{b = 66\}, f = 77\}" \
    "print object, shared vbptr after a base"
gdb_test "print gh.v" " = 11" "shared vbptr of a later base, base's vbase"
gdb_test "print gh.b" " = 66" "shared vbptr of a later base, own vbase"
gdb_test "print gh" \
    " = \{<P> = \{<V> = \{v = 11\}, .*p = 33\}, <W> = \{.*w = 22\}, <B> = \{b = 66\}, h = 88\}" \
    "print object, shared vbptr of a later base"
