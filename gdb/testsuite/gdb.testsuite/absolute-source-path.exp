# Testsuite self-tests for is_absolute_source_path.

gdb_assert {[is_absolute_source_path /usr/src/a.c]} "slash is absolute"
gdb_assert {[is_absolute_source_path C:/src/a.c]} "drive letter is absolute"
gdb_assert {![is_absolute_source_path src/a.c]} "relative name"
gdb_assert {![is_absolute_source_path C:a.c]} "drive-relative name"
