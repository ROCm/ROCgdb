# Testsuite self-tests for relative_filename.

gdb_assert {[relative_filename /usr/src /usr/src/dir/a.c] eq "dir/a.c"} \
    "relative_filename"

# On a MinGW host the same directory can be spelled as a Unix path or as
# the Windows path it is mounted on; GDB reports the latter.
if {[ishost *-*-mingw*]} {
    set root [pwd]
    set full [host_file_normalize [file join $root dir a.c]]
    verbose -log "relative_filename $root $full"
    gdb_assert {[relative_filename $root $full] eq "dir/a.c"} \
	"relative_filename with a Windows-spelled file"
}
