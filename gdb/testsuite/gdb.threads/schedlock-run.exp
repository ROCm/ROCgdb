# Test that restarting a program with "run" while scheduler-locking is
# on lets the program reach its first stop, even though the program
# waits for a thread it creates while starting up.

standard_testfile

if {[prepare_for_testing "failed to prepare" $testfile $srcfile \
	 {debug pthreads}]} {
    return
}

set bp_line [gdb_get_line_number "break here"]

# Scheduler-locking can only be enabled once the program is running.
if {![runto $srcfile:$bp_line]} {
    return
}

gdb_breakpoint $srcfile:$bp_line
gdb_test_no_output "set scheduler-locking on"

gdb_run_cmd
gdb_test "" "Breakpoint $decimal, main \\(\\) at .*break here.*" \
    "run reaches breakpoint"

gdb_test "show scheduler-locking" \
    "Mode for locking scheduler during execution is \"on\"\\." \
    "scheduler-locking is still on"
