# Check layout with only a command window.

require allow_tui_tests

tuiterm_env

Term::clean_restart 24 80

# Use a layout with just a command window.
gdb_test_no_output "tui new-layout command-layout cmd 1"

if {![Term::prepare_for_tui]} {
    unsupported "TUI not supported"
    return
}

# Enter TUI.
gdb_assert {[Term::command_no_prompt_prefix "layout command-layout"]} \
    "activated layout"

foreach op {+ - < >} {
    gdb_assert {[Term::command "$op"]} \
	"scroll command: $op"

    gdb_assert {[Term::command "$op 1"]} \
	"scroll command: $op 1"

    # Regression test for PR34772.  This used to trigger a segfault.
    gdb_assert {[Term::command "$op 1 cmd"]} \
	"scroll command: $op 1 cmd"
}
