# Check handling of abort in TUI.

tuiterm_env
require allow_tui_tests

# This test-case produces a core file.  Let's not do that remotely.
require {!isremote host}

# Check that we're able to use SIGABRT.
require {remote_kill_spawn_id_p host SIGABRT}

Term::clean_restart 24 80

set have_backtrace_on_fatal_signal 0
gdb_test_multiple "maint set backtrace-on-fatal-signal on" "" {
    -re -wrap "support for this feature is not compiled into GDB" {
    }
    -re -wrap "^" {
	set have_backtrace_on_fatal_signal 1
    }
}
require {expr {$have_backtrace_on_fatal_signal}}

# Get the GDB core into the output directory, so that it
# doesn't count as unexpected core in gdb.sum.
set dir [standard_output_file ""]
gdb_test "cd $dir" "Working directory .*" \
    "cd to test directory"

require Term::enter_tui

set gdb_pid [exp_pid -i $::gdb_spawn_id]

kill_gdb SIGABRT

set re_msg_line \
    [string_to_regexp \
	 "This is a bug, please report it."]
set re_msg \
    [multi_line \
	 "" \
	 $re_msg_line]
gdb_assert \
    {[Term::wait_for_region_contents 0 0 80 24 $re_msg]} \
    "saw message"

set seen_eof 0
gdb_expect {
    eof {
	set seen_eof 1
	remove_core $gdb_pid
	gdb_exit_cleanup
    }
}

gdb_assert {$seen_eof} "aborted"
